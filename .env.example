# Copy to .env and fill in. .env is git-ignored.

# Panorama / PAN-OS
PANORAMA_HOST=panorama.example.com
PANORAMA_API_KEY=
PANOS_VERIFY_TLS=true

# Zscaler Private Access (OAuth client credentials — create under Administration > API Keys)
ZPA_BASE_URL=https://config.private.zscaler.com
ZPA_CLIENT_ID=
ZPA_CLIENT_SECRET=
ZPA_CUSTOMER_ID=

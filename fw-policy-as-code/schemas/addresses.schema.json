{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Address objects file",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^(H-\\d{1,3}(\\.\\d{1,3}){3}|N-\\d{1,3}(\\.\\d{1,3}){3}_\\d{1,2}|R-[0-9.]+-[0-9.]+|F-[A-Za-z0-9.-]+)$" },
          "value": { "type": "string" },
          "type": { "enum": ["ip-netmask", "ip-range", "fqdn"], "default": "ip-netmask" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "address_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "members"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^AG-[a-z0-9-]+$" },
          "members": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lint exceptions register",
  "type": "object",
  "required": ["exceptions"],
  "additionalProperties": false,
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "check", "reason", "chg", "approver", "expires"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "check": { "type": "string" },
          "reason": { "type": "string", "minLength": 10 },
          "chg": { "type": "string", "pattern": "^CHG\\d{7}$" },
          "approver": { "type": "string" },
          "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
